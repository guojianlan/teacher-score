{
  "name": "teacher-score",
  "private": true,
  "version": "0.0.0",
  "description": "教师 LLM 试卷批改 SaaS",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "dev": "pnpm dev:all",
    "dev:all": "dotenv -e .env -- concurrently --names backend,worker,web --prefix-colors blue,magenta,green \"pnpm dev:backend\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:web": "dotenv -e .env -- pnpm --filter @teacher-score/web dev",
    "dev:backend": "dotenv -e .env -- pnpm --filter @teacher-score/backend dev",
    "dev:worker": "dotenv -e .env -- pnpm --filter @teacher-score/backend dev:worker",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=./packages/* --filter=./apps/* test",
    "db:generate": "dotenv -e .env -- pnpm --filter @teacher-score/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @teacher-score/db migrate",
    "db:push": "dotenv -e .env -- pnpm --filter @teacher-score/db push",
    "seed:demo": "dotenv -e .env -- tsx scripts/seed-demo.ts",
    "seed:bio": "dotenv -e .env -- tsx scripts/seed-bio-sheet.ts",
    "synth:sheet": "dotenv -e .env -- tsx scripts/synth-answer-sheet.ts",
    "e2e:grading": "dotenv -e .env -- tsx scripts/e2e-grading.ts",
    "report:validation": "dotenv -e .env -- tsx scripts/build-validation-report.ts",
    "fixtures:synth": "tsx scripts/generate-synthetic-fixtures.ts",
    "tokens:sync": "tsx apps/web/src/styles/tokens/sync.ts",
    "tokens:export-json": "tsx scripts/export-tokens-json.ts",
    "tokens:palette": "tsx scripts/add-palette.ts",
    "tokens:add-color": "tsx scripts/add-color.ts",
    "tokens:audit": "tsx scripts/audit-tokens.ts",
    "tokens:validate": "tsx scripts/validate-tokens.ts",
    "tokens:snapshot": "tsx scripts/snapshot-tokens.ts",
    "tokens:lab": "open docs/claude/design-lab.html",
    "accuracy": "dotenv -e .env -- tsx scripts/accuracy-test.ts",
    "e2e": "pnpm --filter @teacher-score/e2e test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^20.16.0",
    "concurrently": "^9.2.1",
    "culori": "^4.0.2",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.3.3",
    "puppeteer": "^25.0.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
