{
  "name": "teacher-score",
  "private": true,
  "version": "0.0.0",
  "description": "教师 LLM 试卷批改 SaaS",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "dev:web": "pnpm --filter @teacher-score/web dev",
    "dev:backend": "pnpm --filter @teacher-score/backend dev",
    "dev:worker": "pnpm --filter @teacher-score/backend dev:worker",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @teacher-score/db generate",
    "db:migrate": "pnpm --filter @teacher-score/db migrate",
    "db:push": "pnpm --filter @teacher-score/db push",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "fixtures:synth": "tsx scripts/generate-synthetic-fixtures.ts",
    "accuracy": "tsx scripts/accuracy-test.ts",
    "e2e": "pnpm --filter @teacher-score/e2e test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
