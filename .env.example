# ============ Database ============
DATABASE_URL=postgres://user:pass@localhost:5432/teacher_score
DATABASE_POOL_MAX=10

# ============ Auth ============
# 32+ char random string. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Google OAuth (optional — §十.1). Unset = email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signature key for 7-day parent share links (§十.10). 32+ char random.
SHARE_LINK_SECRET=replace-me-too

# ============ AI / LLM ============
# OpenAI-compatible endpoint. Leave unset to run with a deterministic mock.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_VISION_MODEL=gpt-5.5-vision
AI_MAX_TOKENS=4000
AI_COST_CENTS_PER_1K=1.5

# LLM circuit breakers (§六.8)
LLM_TOKEN_LIMIT=8000
LLM_COST_CENTS_LIMIT=20

# ============ Storage ============
# local | supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=teacher-score-uploads

# ============ Email ============
# Leave RESEND_API_KEY unset to fall back to console transport (dev).
RESEND_API_KEY=
EMAIL_FROM=no-reply@teacher-score.local

# ============ Monitoring ============
# Sentry / PostHog. Optional; if unset, telemetry is silently disabled.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ============ App URLs ============
# Browser ALWAYS talks to same-origin /api/* (Next rewrites).
# This is only used by RSC / Server Components via api-server.ts.
BACKEND_INTERNAL_URL=http://localhost:3001

# Backend HTTP port
BACKEND_PORT=3001

# Worker
WORKER_TEAM_SIZE=2

# pg-boss
PGBOSS_SCHEMA=pgboss

# Rate limits
RATE_LIMIT_USER_PER_MIN=100
RATE_LIMIT_IP_PER_MIN=1000

# Logging
LOG_LEVEL=debug
NODE_ENV=development
