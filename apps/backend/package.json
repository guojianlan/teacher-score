{
  "name": "@teacher-score/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/http.ts",
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:http": "node dist/http.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@teacher-score/ai": "workspace:*",
    "@teacher-score/analytics": "workspace:*",
    "@teacher-score/auth": "workspace:*",
    "@teacher-score/db": "workspace:*",
    "@teacher-score/email": "workspace:*",
    "@teacher-score/jobs": "workspace:*",
    "@teacher-score/logger": "workspace:*",
    "@teacher-score/pdf": "workspace:*",
    "@teacher-score/storage": "workspace:*",
    "@teacher-score/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "pg-boss": "^10.1.5",
    "sharp": "^0.33.5",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@teacher-score/config": "workspace:*",
    "@types/node": "^20.16.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
